# PrintBar Raspberry Pi Agent Environment Configuration
# Copy to .env on the Raspberry Pi: cp .env.example .env

# Cloud Next.js API Base URL (no trailing slash)
CLOUD_API_URL=https://your-printbar-app.railway.app

# Device Identity
DEVICE_ID=PB-K01

# Shared secret for HMAC-SHA256 device authentication (must match DEVICE_AUTH_SECRET in cloud .env)
DEVICE_AUTH_SECRET=generate-a-strong-secret-matching-cloud

# CUPS Queue Names configured on Raspberry Pi via lpadmin
KYOCERA_QUEUE=Kyocera_PA3500x
CANON_QUEUE=Canon_GX6170

# Polling intervals
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=30
