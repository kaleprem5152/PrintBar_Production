# ==============================================================================
# PrintBar Raspberry Pi Agent — Environment Configuration Template
# Copy to /etc/printbar/printbar.env and fill in real values.
# This file must NEVER be committed to version control.
# ==============================================================================

# Cloud backend URL (Railway production)
CLOUD_API_URL=https://printbarproduction-production.up.railway.app

# Kiosk identity
DEVICE_ID=PB-K01

# HMAC authentication secret — generate with: openssl rand -hex 32
# Must match PRINTBAR_DEVICE_SECRET in Railway environment variables.
DEVICE_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Printer Network Configuration
# Assign static IPs via your router's DHCP reservation table.
# ---------------------------------------------------------------------------
KYOCERA_IP=
CANON_IP=

KYOCERA_QUEUE=printbar-kyocera
CANON_QUEUE=printbar-canon
KYOCERA_PORT=9100
CANON_PORT=9100

# ---------------------------------------------------------------------------
# Timing
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=30
COMMAND_POLL_INTERVAL=10

# ---------------------------------------------------------------------------
# Storage (default paths set by install.sh)
# ---------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=/var/lib/printbar/jobs
LOCAL_DATA_DIR=/var/lib/printbar

# ---------------------------------------------------------------------------
# Kiosk Display Browser
# ---------------------------------------------------------------------------
KIOSK_URL=https://printbarproduction-production.up.railway.app/kiosk

# ---------------------------------------------------------------------------
# Mode & Logging
# PRODUCTION_MODE=true enforces strict config validation at startup.
# ---------------------------------------------------------------------------
PRODUCTION_MODE=true
LOG_LEVEL=INFO
