# PrintBar — Environment Variables
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# Never put real secrets here.

# ─── Database ───────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (from Supabase dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase project keys (from Supabase dashboard > Settings > API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Application ────────────────────────────────────────────────────────────
# Full public URL of the deployed Next.js app (no trailing slash)
# Used for Cashfree return URLs and webhook registration
APP_BASE_URL=https://your-printbar-app.railway.app

# Node environment: development | production
NODE_ENV=production

# ─── Admin Authentication ───────────────────────────────────────────────────
# Secret used to sign admin session JWTs (minimum 64 random chars)
ADMIN_SESSION_SECRET=

# ─── Device (Raspberry Pi) Authentication ───────────────────────────────────
# Unique identifier for this PrintBar machine
DEVICE_ID=PB-K01

# Shared secret for Raspberry Pi to authenticate with the cloud API
# Must match the value in raspberry-pi-agent/.env on the Pi
DEVICE_AUTH_SECRET=

# ─── Cashfree Payments ──────────────────────────────────────────────────────
# Cashfree API credentials (from Cashfree merchant dashboard)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Environment: sandbox | production
CASHFREE_ENV=sandbox

# API version (use the version you integrated against)
CASHFREE_API_VERSION=2023-08-01

# ─── File Storage ───────────────────────────────────────────────────────────
# Absolute path for temporary document storage on the server
# On Railway this will typically be /tmp/printbar-uploads
# On Raspberry Pi this will be set in the agent's own config
TEMP_STORAGE_PATH=/tmp/printbar-uploads

# Time-limited URL secret for secure file serving to the Raspberry Pi
# Minimum 32 random hex chars
FILE_SERVING_SECRET=

# ─── Cashfree Webhook ───────────────────────────────────────────────────────
# Cashfree sends this secret in webhooks — must match your Cashfree dashboard setting
# This is used to verify webhook signatures
CASHFREE_WEBHOOK_SECRET=
